# Copy values into the shell or use a dotenv launcher; src/dev.ts does not load
# this file by itself. `npm run dev:api` supplies safe local defaults.
HOST=127.0.0.1
PORT=4000
# `eversally` for the hosted product; `ubeeq` for the OSS distribution.
PRODUCT_BRAND=ubeeq
TENANT_ID=default
DEV_HTTPS=true
LOCAL_AUTH_USER_ID=local-user
LOCAL_MEDIA_DIRECTORY=/tmp/eversally-media
APP_ORIGIN=https://fanadmin.top:5174
EXTERNAL_OAUTH_REDIRECT_URI=https://fanadmin.top:4000/integrations/deviantart/callback
SOUNDCLOUD_ENABLED=false
SOUNDCLOUD_OAUTH_REDIRECT_URI=https://fanadmin.top:4000/integrations/soundcloud/callback
# Discord server installations use a confidential OAuth client. For a shared
# AWS environment, set DISCORD_SECRETS_NAME during CDK deploy and store
# discordClientSecret + discordBotToken in that Secrets Manager JSON object.
DISCORD_CLIENT_ID=
DISCORD_OAUTH_REDIRECT_URI=https://fanadmin.top:4000/integrations/discord/callback
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# YouTube uses a standard Google OAuth web client. Enable only the
# youtube.readonly scope for this first import/embed release.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://fanadmin.top:4000/integrations/youtube/callback
YOUTUBE_MIN_REQUEST_INTERVAL_MS=1000
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
# Bluesky/AT Protocol OAuth is intentionally disabled locally unless all four
# values are supplied through a public HTTPS client-metadata host and callback.
BLUESKY_OAUTH_CLIENT_METADATA_URL=
BLUESKY_OAUTH_CALLBACK_URL=
BLUESKY_OAUTH_JWKS_JSON=
BLUESKY_OAUTH_PRIVATE_JWK=
# The product API never receives a Bluesky refresh token. It verifies a
# short-lived connection proof from this separately deployed OAuth broker.
BLUESKY_OAUTH_SERVICE_URL=
BLUESKY_OAUTH_SERVICE_JWKS_URL=
# Generate once with: openssl rand -base64 48
EXTERNAL_TOKEN_ENCRYPTION_KEY=

AWS_REGION=ca-central-1
CREATORS=creators
GROUPINGS_TABLE=groupings
IMAGES_TABLE=images
COMMENTS_TABLE=comments
FAVORITES_TABLE=favorites
BLOCKED_USERS_TABLE=blocked-users
CONTENT_CORE_TABLE=content-core
USE_CONTENT_CORE_TABLE=false
MEDIA_BUCKET=content-media
MEDIA_CDN_DOMAIN=
PREMIUM_MEDIA_CDN_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
UNLOCK_JWT_SECRET=replace-me
UNLOCK_TOKEN_TTL_SECONDS=3600
REMEMBER_GALLERY_ACCESS_TTL_SECONDS=2592000
SIGNED_URL_TTL_SECONDS=300
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_TOKEN_USE=id
# Optional first-admin bootstrap. Eversally defaults ADMIN_EMAIL to
# admin@eversally.com; Ubeeq defaults to admin@ubeeq.site. The password is
# required to create the user and is never logged or used to reset an existing
# account. In production, prefer the adminPassword key in APP_SECRETS_NAME.
ADMIN_EMAIL=admin@eversally.com
ADMIN_PASSWORD=
DEVIANTART_PUBLISHED_DESCRIPTION_UPDATE=true
EXTERNAL_CONTENT_MAX_BYTES=52428800
# Defaults to false outside production; set true only when scheduled provider polling is wanted.
EXTERNAL_SCHEDULED_SCANS_ENABLED=false
EXTERNAL_ACCOUNT_SCAN_INTERVAL_SECONDS=21600
EXTERNAL_ACTIVITY_SCAN_INTERVAL_SECONDS=120
